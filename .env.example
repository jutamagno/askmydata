# Copie para .env e preencha os valores

# --- LLM ---
# Deixe ANTHROPIC_API_KEY vazio (ou remova) para usar Ollama local (padrão)
# Preencha para usar Claude da Anthropic
ANTHROPIC_API_KEY=

# Modelo Ollama a baixar e usar (padrão: codellama)
# Outros bons pra SQL: qwen2.5-coder, sqlcoder, mistral
OLLAMA_MODEL=codellama

# --- Auth ---
SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Frontend ---
# URL que o navegador usa pra chegar no backend
NEXT_PUBLIC_API_URL=http://localhost:8000
